# =============================================================
# OpsPilot — https://opspilot.es (sin www)
# Web SSG (vite-react-ssg): HTML estatico por ruta en carpetas.
# Reglas: HTTPS + host canonico + redirects 301 finales +
# 404 real + seguridad + cache + compresion.
# Todo con guards <IfModule> para no romper si falta un modulo.
#
# CONVENCION DE URL: CON barra final (/casos/, no /casos). No es una
# preferencia estetica, es lo que este servidor ya hacia por su cuenta: con
# dirStyle 'nested' cada ruta es un DIRECTORIO en dist/, asi que mod_dir
# responde 301 de /casos a /casos/ antes de servir su index.html. Los
# canonicals, og:url, hreflang, sitemap y breadcrumbs declaran esa misma
# forma para que lo declarado y lo servido coincidan.
# =============================================================

# -------------------------------------------------------------
# 1) Reescrituras: HTTPS, host canonico y redirects 301
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Marca los assets con hash (/assets/*) para aplicarles cache immutable.
  # El env HASHED lo lee el bloque de mod_headers mas abajo.
  RewriteRule ^assets/ - [E=HASHED:1]

  # 1. Forzar HTTPS (http -> https, 301). HTTP_HOST conserva el host actual.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Host canonico sin www: www.opspilot.es -> opspilot.es (301).
  #    Los canonicals y el sitemap usan https://opspilot.es (sin www).
  RewriteCond %{HTTP_HOST} ^www\.opspilot\.es$ [NC]
  RewriteRule ^ https://opspilot.es%{REQUEST_URI} [R=301,L]

  # 3. Redirects 301 reales server-side hacia el destino FINAL (sin cadenas).
  #    Contemplan con y sin barra final en el ORIGEN.
  #
  #    El destino lleva barra final. Antes no la llevaba y el fichero
  #    presumia en este mismo comentario de "sin cadenas" mientras producia
  #    exactamente eso: /services -> 301 /contacto -> 301 (mod_dir) /contacto/
  #    Dos saltos para llegar al mismo sitio, diluyendo autoridad y gastando
  #    presupuesto de rastreo por nada. Con la barra puesta aqui el redirect
  #    aterriza directo en el destino final, que es lo que el comentario
  #    siempre dijo que hacia.

  #    3a. Rutas comerciales/legacy -> /contacto/
  RewriteRule ^services/?$        /contacto/ [R=301,L]
  RewriteRule ^servicios/?$       /contacto/ [R=301,L]
  RewriteRule ^precios/?$         /contacto/ [R=301,L]
  RewriteRule ^pricing/?$         /contacto/ [R=301,L]
  RewriteRule ^diagnostico/?$     /contacto/ [R=301,L]
  RewriteRule ^demo/?$            /contacto/ [R=301,L]
  RewriteRule ^contact/?$         /contacto/ [R=301,L]

  #    3b. Casos (EN) -> /casos/
  RewriteRule ^cases/?$           /casos/ [R=301,L]

  #    3c. Recursos (EN) -> /recursos/
  RewriteRule ^resources/?$       /recursos/ [R=301,L]

  #    3d. Producto/productos -> /recursos/
  RewriteRule ^product/?$         /recursos/ [R=301,L]
  RewriteRule ^productos/?$       /recursos/ [R=301,L]
</IfModule>

# -------------------------------------------------------------
# 4) 404 real para paths desconocidos
# -------------------------------------------------------------
# Aqui vivia un fallback SPA: si el path solicitado no era archivo,
# directorio ni symlink existente, se reescribia INTERNAMENTE a /index.html.
# Esa reescritura interna no cambia el codigo de estado, asi que Apache
# respondia 200 OK a CUALQUIER path inventado, sirviendo el prerender de la
# home con su "robots: index, follow" y su canonical a "/". Traducido: una
# fabrica de paginas indexables infinitas. Ya hay basura indexada explotandolo
# (p. ej. /landing-oficial-24542/diseno-web-para-pymes/automatizaciones/), y
# el /404/index.html que SI lleva noindex no se servia jamas.
#
# Con SSG el fallback ya no hace falta para que la web funcione: vite-react-ssg
# prerenderiza todas las rutas reales como carpeta con su index.html
# (incluidos los 17 articulos de /recursos/<slug>, los stubs de redirect y la
# propia /404/), asi que mod_dir + DirectoryIndex las resuelven solas. Lo unico
# que cubria el fallback eran los paths que NO existen — que es precisamente lo
# que debe devolver 404.
#
# ErrorDocument es core de Apache (no necesita <IfModule>): sirve el documento
# manteniendo el codigo 404 y sin cambiar la URL del navegador, asi que el
# usuario ve la pagina de error de la web y el rastreador ve un 404 de verdad.
ErrorDocument 404 /404/index.html

# -------------------------------------------------------------
# 5) Cabeceras de seguridad
# -------------------------------------------------------------
<IfModule mod_headers.c>
  # Evita el MIME-sniffing del navegador
  Header always set X-Content-Type-Options "nosniff"
  # Evita embeber la web en iframes de otros origenes (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Referrer: envia origen completo same-origin, solo origen cross-origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Desactiva APIs sensibles que no usamos
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # HSTS: fuerza HTTPS durante 1 año en este dominio y subdominios.
  # NOTA: activar "; preload" SOLO cuando estes seguro (es irreversible a
  # corto plazo y requiere enviar el dominio a hstspreload.org).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # CSP en modo Report-Only: NO bloquea, solo reporta violaciones.
  # Se usa Report-Only porque no podemos testear Apache localmente y una CSP
  # mal ajustada rompe produccion sin margen de prueba. Se puede PROMOVER a
  # enforce (cabecera Content-Security-Policy) tras validar que no hay
  # violaciones legitimas en los reportes del navegador.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://plausible.io https://formsubmit.co"
</IfModule>

# -------------------------------------------------------------
# 6) Cache: assets con hash immutable, HTML sin cache, imagenes sin hash 7d
# -------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # JS/CSS/fuentes (siempre con hash en /assets/) -> 1 año
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript        "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
  ExpiresByType font/ttf               "access plus 1 year"

  # Imagenes/SVG -> 7 dias por defecto (las de /assets/ con hash suben a
  # immutable via Cache-Control en el bloque mod_headers, que es autoritativo)
  ExpiresByType image/png              "access plus 7 days"
  ExpiresByType image/jpeg             "access plus 7 days"
  ExpiresByType image/gif              "access plus 7 days"
  ExpiresByType image/webp             "access plus 7 days"
  ExpiresByType image/avif             "access plus 7 days"
  ExpiresByType image/svg+xml          "access plus 7 days"
  ExpiresByType image/x-icon           "access plus 7 days"

  # HTML -> sin cache, revalidar siempre (el prerender se actualiza en cada deploy)
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Assets con hash (/assets/*, marcados con env HASHED) -> immutable 1 año.
  # El hash en el nombre invalida la cache al cambiar el contenido.
  Header set Cache-Control "public, immutable, max-age=31536000" env=HASHED

  # HTML -> siempre revalidar contra el servidor (deploy visible al instante).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Imagenes/SVG SIN hash (fuera de /assets/) -> 7 dias.
  # Se aplica solo si NO es un asset con hash (env HASHED no definido).
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800" env=!HASHED
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------
# 7) Compresion de texto
# -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml text/xml
</IfModule>
