---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Propuesta from '../components/Propuesta.astro';
import Problemas from '../components/Problemas.astro';
import PlanVuelo from '../components/PlanVuelo.astro';
import Cierre from '../components/Cierre.astro';
import Recorrido from '../components/Recorrido.astro';
import PorQue from '../components/PorQue.astro';
import { SERVICIO_LOCAL } from '../lib/sitio';
---
<Base title="Agencia de digitalización en Córdoba · OpsPilot"
  description="Webs, ficha de Google y herramientas a medida para negocios de Córdoba. Casos reales, precio cerrado desde 500 € y respuesta en menos de 24 h."
  path="/" jsonld={[SERVICIO_LOCAL]}>
  <Portada />
  <Problemas />
  <Propuesta />
  <Recorrido />
  <PorQue />
  <PlanVuelo />
  <Cierre />
</Base>
