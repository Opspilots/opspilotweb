---
import Base from '../layouts/Base.astro';
import CabeceraMesa from '../components/CabeceraMesa.astro';
import QueHacemos from '../components/QueHacemos.astro';
import Propuesta from '../components/Propuesta.astro';
import Problemas from '../components/Problemas.astro';
import PlanVuelo from '../components/PlanVuelo.astro';
import Cierre from '../components/Cierre.astro';
import PorQue from '../components/PorQue.astro';
import { SERVICIO_LOCAL } from '../lib/sitio';
---
<Base title="Agencia de digitalización y webs en Córdoba · OpsPilot"
  description="Webs y ficha de Google desde 500 €, soluciones a medida y herramientas gratis para negocios de Córdoba. Respuesta en menos de 24 h."
  path="/" jsonld={[SERVICIO_LOCAL]}>
  <CabeceraMesa />
  <QueHacemos />
  <Problemas />
  <Propuesta />
  <PorQue />
  <PlanVuelo />
  <Cierre />
</Base>
