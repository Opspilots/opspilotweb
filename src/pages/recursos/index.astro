---
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import Cierre from '../../components/Cierre.astro';
import { RESOURCES } from '../../lib/resources';
import { HERRAMIENTAS, GRUPOS } from '../../data/herramientas';
import { migas, SITE_URL, WA } from '../../lib/sitio';

const M = [{ nombre: 'Inicio', path: '/' }, { nombre: 'Recursos gratis', path: '/recursos/' }];
// Destacados primero y después por fecha, lo más reciente arriba.
// Orden: lo que sirve a un pequeño negocio primero (checklist, guías, artículos) y los productos al final.
const ORDEN = ['Checklist', 'Guía', 'Artículo', 'Producto'];
const lista = [...RESOURCES].sort((a, b) => ORDEN.indexOf(a.cat) - ORDEN.indexOf(b.cat) || Number(!!b.featured) - Number(!!a.featured) || (b.date ?? '').localeCompare(a.date ?? ''));
// Por dónde empezar: la situación con las palabras del dueño y la guía que le toca.
const EMPIEZA = [
  ['Mi web no me trae clientes.', 'checklist-tu-web-trabaja-para-ti'],
  ['Lo llevo todo en Excel y se me escapan cosas.', 'migrar-de-excel-a-sistema-pyme'],
  ['Quiero automatizar, pero no sé qué.', 'automatiza-tu-negocio-sin-saber-de-tecnologia'],
  ['Voy a pedir presupuesto y no quiero que me timen.', 'como-pedir-presupuesto-de-software'],
].map(([sit, slug]) => ({ sit, r: RESOURCES.find((x) => x.slug === slug)! })).filter((x) => x.r);
const CATS = ORDEN.filter((c) => RESOURCES.some((r) => r.cat === c));
const blog = {
  '@type': 'Blog',
  name: 'Recursos de OpsPilot',
  url: `${SITE_URL}/recursos/`,
  blogPost: lista.map((r) => ({ '@type': 'BlogPosting', headline: r.title, url: `${SITE_URL}/recursos/${r.slug}/`, ...(r.date ? { datePublished: r.date } : {}) })),
};
---
<Base title="Recursos gratis para pequeños negocios · OpsPilot"
  description="Herramientas y guías gratis para pequeños negocios: Google Maps, reseñas, WhatsApp, presupuestos, IVA e IRPF, Verifactu y cómo digitalizarte sin tecnicismos."
  path="/recursos/" jsonld={[migas(M), blog]}>
  <CabeceraPagina sobre="Recursos" titulo="Herramientas y guías gratis para tu negocio, sin tecnicismos."
    entrada="Lo que explicamos en las primeras conversaciones, por escrito y gratis. Para decidir con criterio antes de gastar un euro.">
    <div class="acciones">
      <a class="enlace" href={WA('Hola OpsPilot, tengo una duda que no está en vuestras guías:')} rel="noopener">¿Tu duda no está aquí? Pregúntanosla <svg class="ico" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
    </div>
  </CabeceraPagina>
  <section class="s-papel" aria-labelledby="t-gratis">
    <div class="wrap">
      <p class="etiqueta">Herramientas gratis</p>
      <h2 id="t-gratis" class="h2">Resuélvelo ahora, en dos minutos.</h2>
      <div class="rec-grupos">
        {GRUPOS.map((g) => (
          <div>
            <h3 class="rec-grupo-t">{g.titulo}</h3>
            <ul class="hz-otras">
              {HERRAMIENTAS.filter((o) => o.grupo === g.id).map((o) => (
                <li><a href={`/herramientas/${o.slug}/`}>
                  <span class="hz-otras-ico"><svg class="ico" aria-hidden="true"><use href={`#i-${o.icono}`}/></svg></span>
                  <span><small>«{o.busqueda}»</small><b>{o.nombre}</b></span>
                  <svg class="ico" aria-hidden="true"><use href="#i-chevron-right"/></svg>
                </a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="s-navy" aria-labelledby="t-empieza">
    <div class="wrap">
      <p class="etiqueta">Empieza por aquí</p>
      <h2 id="t-empieza" class="h2">¿Qué te pasa? Te decimos qué leer primero.</h2>
      <ol class="empieza">
        {EMPIEZA.map(({ sit, r }) => (
          <li><a href={`/recursos/${r.slug}/`}>
            <span class="empieza-sit">«{sit}»</span>
            <span class="empieza-guia"><small>{r.cat} · {r.time} de lectura</small>{r.title}</span>
            <svg class="ico" aria-hidden="true"><use href="#i-chevron-right"/></svg>
          </a></li>
        ))}
      </ol>
    </div>
  </section>
  <section class="s-papel" aria-labelledby="t-rec">
    <div class="wrap">
      <h2 id="t-rec" class="h2">Guías para leer con calma.</h2>
      <div class="recursos-filtro" role="group" aria-label="Filtrar por tipo" data-filtro hidden>
        <button type="button" aria-pressed="true" data-cat="">Todo</button>
        {CATS.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{c}</button>)}
      </div>
      <ol class="cuaderno">
        {lista.map((r, i) => (
          <li class="cuaderno-fila" data-item data-cat={r.cat}>
            <a href={`/recursos/${r.slug}/`}>
              <span class="cuaderno-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="cuaderno-c">
                <span class="cuaderno-cat">{r.cat} · {r.time} de lectura</span>
                <h3>{r.title}</h3>
                <p>{r.desc}</p>
              </span>
              {r.cover && <span class="cuaderno-img"><img src={r.cover} alt="" width="640" height="360" loading="lazy" decoding="async"></span>}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <Cierre />
  <script is:inline>
    (function () {
      var f = document.querySelector('[data-filtro]'); if (!f) return; f.hidden = false;
      var bs = f.querySelectorAll('button'), cs = document.querySelectorAll('[data-item]');
      bs.forEach(function (b) { b.addEventListener('click', function () {
        bs.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        cs.forEach(function (c) { c.hidden = !!b.dataset.cat && c.dataset.cat !== b.dataset.cat; });
      }); });
    })();
  </script>
</Base>
