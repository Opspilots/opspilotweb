---
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import PlanVuelo from '../../components/PlanVuelo.astro';
import Cierre from '../../components/Cierre.astro';
import PorQue from '../../components/PorQue.astro';
import { SECTORS } from '../../data/sectors';
import Tramos, { type Tramo } from '../../components/Tramos.astro';
import CordobaSoluciona from '../../components/pantallas/CordobaSoluciona.astro';
import ErpHosteleria from '../../components/pantallas/ErpHosteleria.astro';
import PresupuesYa from '../../components/pantallas/PresupuesYa.astro';
import { LINEAS, migas, SITE_URL } from '../../lib/sitio';

// Cada sector de la web anterior cae en una de las tres líneas. Se conserva su id como ancla
// (/soluciones/#reformas…) para no romper enlaces antiguos.
const LINEA_DE: Record<string, number> = { asesorias: 1, energia: 1, reformas: 1, agencias: 2, hosteleria: 1, pymes: 2, medida: 1 };

// Las tres líneas como tramos: el síntoma con las palabras del dueño, lo que lleva y algo real que se puede tocar.
const TRAMOS: Tramo[] = [
  {
    id: 'webs', nombre: 'Webs y tiendas online', sintoma: 'Me buscan en Google y sale otro.',
    bg: '#2F5E3B', fg: '#FBFAF5', ac: '#FFC9A8',
    titulo: 'Que te encuentren y te escriban, sin salir a buscarlos.',
    texto: 'Una web hecha para lo que busca la gente de tu zona, y tu ficha de Google al día. Si vendes, con tienda o con el pedido directo a tu WhatsApp.',
    lista: ['Una página por cada servicio y cada pueblo o barrio', 'Ficha de Google completa y reseñas respondidas', 'Tienda con carrito, o pedido por WhatsApp', 'Rápida en el móvil y medida antes de entregarla'],
    datos: [{ cifra: 'Desde 500 €', que: 'precio cerrado y por escrito, con la mitad al empezar' }],
    enlace: { url: '/soluciones/webs-y-tiendas/', texto: 'Ver webs y tiendas' },
  },
  {
    id: 'software', nombre: 'Software a medida', sintoma: 'Lo tengo en el WhatsApp, en la libreta y en un Excel.',
    bg: '#0D131C', fg: '#E9EEF4', ac: '#00FF6A',
    titulo: 'Pedidos, clientes y facturas en un solo sitio.',
    texto: 'Cuando ningún programa encaja con cómo trabajas, lo hacemos alrededor de tu forma de trabajar. Esta pantalla es nuestro ERP para hostelería: tócala.',
    lista: ['Lo que hoy vive en cuatro sitios, en uno', 'Una pantalla con lo que hay que atender hoy', 'Cada persona ve y toca solo lo suyo', 'Precio cerrado antes de empezar'],
    enlace: { url: '/soluciones/software-a-medida/', texto: 'Ver software a medida' },
  },
  {
    id: 'automatizacion', nombre: 'Automatización', sintoma: 'Hago lo mismo a mano diez veces al día.',
    bg: '#0E0E0E', fg: '#F4EFE6', ac: '#DD9717',
    titulo: 'Lo repetitivo, hecho solo.',
    texto: 'Presupuestos, recordatorios, documentos: lo que copias y pegas cada día lo hace el sistema, y una persona revisa lo que importa. Aquí, en PresupuesYa: dictas la partida y se crea sola.',
    lista: ['Respuestas y recordatorios que salen solos', 'Datos que entran una vez y viajan solos', 'Documentos sin copiar y pegar'],
    enlace: { url: '/soluciones/automatizacion/', texto: 'Ver automatización' },
  },
];
const itemList = {
  '@type': 'ItemList',
  name: 'Soluciones de OpsPilot',
  itemListElement: LINEAS.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.label, url: `${SITE_URL}${l.href}` })),
};
---
<Base title="Webs, software a medida y automatización · OpsPilot"
  description="Tres formas de poner orden en tu negocio: webs y tiendas que venden, software a medida y automatización de lo repetitivo. Desde Córdoba, con precio cerrado."
  path="/soluciones/" jsonld={[migas([{ nombre: 'Inicio', path: '/' }, { nombre: 'Soluciones', path: '/soluciones/' }]), itemList]}>
  <CabeceraPagina sobre="Soluciones" titulo="Soluciones de digitalización: tres formas de poner orden en tu negocio."
    entrada="Que te encuentren, tenerlo todo en un sitio o quitarte de encima lo repetitivo. Con precio cerrado y desde Córdoba." />

  <Tramos tramos={TRAMOS} idSeccion="lineas" etiqueta="Tres líneas" titulo="¿Qué te está pasando?" lead="Elige lo que más se parezca a tu día a día. Cada línea, con algo real que puedes tocar.">
    <CordobaSoluciona slot="v-webs" />
    <ErpHosteleria slot="v-software" />
    <PresupuesYa slot="v-automatizacion" />
  </Tramos>

  <section class="s-papel" aria-labelledby="t-sectores">
    <div class="wrap">
      <p class="etiqueta">Por sector</p>
      <h2 id="t-sectores" class="h2">¿Tu sector? Te decimos por dónde empezar.</h2>
      <ul class="sectores-fila">
        {SECTORS.map((s) => {
          const l = LINEAS[LINEA_DE[s.id] ?? 1];
          return <li id={s.id}><a href={l.href}>{s.title}<small>{l.corto}</small></a></li>;
        })}
      </ul>
      <p class="lead">Si el tuyo no está, cuéntanos cómo trabajas: lo que importa es tu proceso, no la etiqueta.</p>
    </div>
  </section>

  <PorQue />
  <PlanVuelo />
  <Cierre />
</Base>
