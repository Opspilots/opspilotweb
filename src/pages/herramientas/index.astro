---
// /herramientas/ (16-nov-2026, tarde): un bloque por grupo, cada uno con su móvil (el mismo de las cabeceras),
// alternando lado y fondo. 17-nov: sin el aro detrás ni en la cabecera («se ve mucho el logo»). Antes, una sola lista larga. Los titulares son la
// pregunta del dueño (la Q de «Que…» no va en un titular grande: su cola parece un subrayado).
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import Cierre from '../../components/Cierre.astro';
import Movil from '../../components/Movil.astro';
import { HERRAMIENTAS } from '../../data/herramientas';
import { migas, SITE_URL, WA } from '../../lib/sitio';
import { version } from '../../lib/version';

const FORMAS = `/css/formas.css?v=${version('/css/formas.css')}`;
const BLOQUES = [
  { id: 'que-te-encuentren', grupo: 'google', titulo: '¿No te encuentran en Google o no te eligen?', movil: 'maps' as const },
  { id: 'papeles', grupo: 'dinero', titulo: '¿Papeles, precios y facturas?', movil: 'calc' as const },
];
const lista = {
  '@type': 'ItemList', name: 'Herramientas gratis para pequeños negocios',
  itemListElement: HERRAMIENTAS.map((h, i) => ({ '@type': 'ListItem', position: i + 1, name: h.nombre, url: `${SITE_URL}/herramientas/${h.slug}/` })),
};
const nombre = (n: string) => (/[?!.]$/.test(n) ? n : `${n}.`);
---
<Base title="Herramientas gratis para pequeños negocios · OpsPilot"
  description="Herramientas gratis para autónomos y pequeños negocios: Google Maps, reseñas, WhatsApp, presupuestos, IVA e IRPF, margen, Verifactu y más."
  path="/herramientas/" jsonld={[migas([{ nombre: 'Inicio', path: '/' }, { nombre: 'Herramientas', path: '/herramientas/' }]), lista]}>
  <link rel="stylesheet" href={FORMAS}>
  <CabeceraPagina titulo="Herramientas gratis para negocios"
    entrada="Para lo que te preguntas cada semana: por qué no sales en Google, cuánto poner de IVA, cuánto cobrar, cómo hacer un presupuesto. Sin registrarte.">
    <div class="acciones">
      <a class="btn btn-tinta" href={WA('Hola OpsPilot, he visto vuestras herramientas gratis y quería consultaros algo:')} rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-message-circle"/></svg>Cuéntanos tu caso</a>
    </div>
  </CabeceraPagina>

  {BLOQUES.map((b, k) => (
    <section class:list={['hz-bloque', k % 2 ? 's-navy hz-inv' : 's-papel']} id={b.id} aria-labelledby={`t-${b.id}`}>
      <div class="wrap hz-bloque-in">
        <div class="hz-tel"><Movil clave={b.movil} /></div>
        <div class="hz-bloque-texto">
          <h2 id={`t-${b.id}`} class="h2">{b.titulo}</h2>
          <ol class="empieza">
            {HERRAMIENTAS.filter((h) => h.grupo === b.grupo).map((h) => (
              <li><a href={`/herramientas/${h.slug}/`}>
                <span class="empieza-sit">«{h.busqueda}»</span>
                <span class="empieza-guia"><small>Gratis</small>{nombre(h.nombre)} {h.frase}</span>
                <svg class="ico" aria-hidden="true"><use href="#i-chevron-right"/></svg>
              </a></li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  ))}

  <section class="corta hz-guias" aria-label="Guías">
    <div class="wrap">
      <a href="/recursos/"><span class="corta-p">¿Prefieres leerlo con calma?</span><span class="corta-r">Guías sin tecnicismos para decidir antes de gastar un euro</span><span class="corta-ir">Ir a las guías <svg class="ico" aria-hidden="true"><use href="#i-chevron-right"/></svg></span></a>
    </div>
  </section>
  <Cierre />
</Base>
