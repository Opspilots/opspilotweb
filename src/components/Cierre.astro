<section class="cierre" aria-labelledby="t-cierre">
    <div class="wrap cierre-in">
      <div class="cierre-texto">
        <h2 id="t-cierre" class="h2-cierre">¿Qué es lo que más te está frenando ahora mismo?</h2>
        <form class="ventana chat" data-chat action="https://wa.me/34640756126" method="get" target="_blank" aria-label="Escríbenos por WhatsApp">
          <div class="v-barra chat-barra">
            <span class="chat-av"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#aro"/></svg></span>
            <span class="v-titulo">OpsPilot<small data-chat-estado>responde en menos de 24 h</small></span>
            <span class="chip chip-demo">Vista previa</span>
          </div>
          <div class="chat-hilo" data-hilo aria-live="polite">
            <p class="chat-dia">Hoy</p>
            <p class="msg msg-op" data-chat-saludo>Hola. Cuéntanos qué te frena y te decimos por dónde empezaríamos.</p>
          </div>
          <fieldset class="chat-resp">
            <legend class="sr">Elige el que más te suene</legend>
            <label><input type="radio" name="freno" value="manual"><span>Pierdo tiempo en tareas manuales</span></label>
            <label><input type="radio" name="freno" value="visibilidad"><span>No tengo visibilidad de mi negocio</span></label>
            <label><input type="radio" name="freno" value="webDebil"><span>Mi web no representa lo que hago</span></label>
            <label><input type="radio" name="freno" value="empezar"><span>No sé por dónde empezar</span></label>
          </fieldset>
          <input type="hidden" name="text" value="Hola OpsPilot, os escribo desde la web.">
          <div class="chat-pie">
            <button class="btn btn-tinta" type="submit"><svg class="ico" aria-hidden="true"><use href="#i-send"/></svg>Seguir por WhatsApp</button>
            <a class="enlace" href="mailto:opspilot.contact@gmail.com">o por correo</a>
          </div>
        </form>
      </div>
      <div class="cierre-aro" aria-hidden="true">
        <div class="giro"><div class="suelo"></div></div>
        <svg class="aro" viewBox="0 0 100 100"><use href="#aro"/></svg>
      </div>
    </div>
  </section>
