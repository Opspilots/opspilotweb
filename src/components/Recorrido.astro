---
// Los casos como un recorrido: al bajar, la sección entera pasa con una transición suave al color de cada
// cliente y su web real se desplaza dentro de la ventana. Sin JS, cada caso lleva su color fijo.
// Los datos salen de src/lib/casos.ts (medidos, con fuente y fecha). `ids` elige qué casos se enseñan y en qué orden:
// la portada lleva uno por promesa; cada página de solución, el suyo. Recuperado el 16-nov-2026 de la rama
// feat/nicho-obra; sin numeración ni línea pequeña sobre el título, como el resto del sistema visual.
import { version } from '../lib/version';
import { CASOS } from '../lib/casos';

interface Props {
  ids?: string[];
  titulo?: string;
  lead?: string;
  /** id de la sección (ancla) */
  id?: string;
}
const {
  ids,
  titulo = '¿Quién lo está usando ya?',
  lead = 'Negocios de aquí, con nombre y con datos medidos. Entra en su web y compara con lo que te contamos.',
  id = 'casos',
} = Astro.props;
const casos = ids ? ids.map((x) => CASOS.find((c) => c.id === x)!).filter(Boolean) : CASOS;

// Capturas de móvil (390 px de ancho a 2x, tomadas de la web pública del cliente): en pantallas estrechas la
// de escritorio (960 px) quedaba ilegible al encogerla. Miden 780 px de ancho y ≤ 3800 de alto (por encima de 4096
// px los móviles las decodifican a trozos y gastan ~20 MB).
const MOVIL = { w: 780, media: '(max-width: 767px)' };
const CSS = `/css/pantallas.css?v=${version('/css/pantallas.css')}`;
const RECORRIDO_JS = `/js/recorrido.js?v=${version('/js/recorrido.js')}`;
---
<link rel="stylesheet" href={CSS}>
<section class="recorrido" id={id} data-recorrido aria-labelledby={`t-${id}`}>
  <div class="wrap recorrido-cab">
    <h2 id={`t-${id}`} class="h2">{titulo}</h2>
    <p class="lead">{lead}</p>
  </div>
  {casos.map((c) => (
    <article class="rc" id={`caso-${c.id}`} data-rc style={`--bg:${c.bg};--fg:${c.fg};--ac:${c.ac}`} aria-labelledby={`t-${id}-${c.id}`}>
      <div class="wrap rc-in">
        <div class="rc-texto">
          <h3 class="rc-nombre">{c.nombre}</h3>
          <p class="rc-donde">{c.donde}</p>
          <p class="rc-titulo" id={`t-${id}-${c.id}`}>{c.titulo}</p>
          <p class="rc-p">{c.texto}</p>
          {c.datos.length > 0 && (
            <dl class="rc-datos">
              {c.datos.map((d) => (
                <div><dt>{d.cifra}</dt><dd>{d.que}<small>{d.fuente}</small></dd></div>
              ))}
            </dl>
          )}
          <a class="enlace rc-ir" href={c.url} rel="noopener">Entrar en su web <svg class="ico" aria-hidden="true"><use href="#i-arrow-up-right"/></svg></a>
        </div>
        <div class="rc-ventana">
          <div class="ventana">
            <div class="v-barra pv-barra"><span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span><span class="pv-tit">{c.dominio}</span></div>
            <div class="rc-vista"><picture>
              <source media={MOVIL.media} srcset={c.imgMovil} width={MOVIL.w} height={c.imgMovilAlto} type="image/webp" />
              <img src={c.img} width="960" height="3467" alt={`La web de ${c.nombre}, de arriba abajo`} loading="lazy" decoding="async" />
            </picture></div>
          </div>
        </div>
      </div>
    </article>
  ))}
</section>
<script is:inline src={RECORRIDO_JS} defer></script>
