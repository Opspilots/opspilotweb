{/* La decisión del modo, en línea y antes del primer pintado (la CSP ya admite 'unsafe-inline' en script-src). Los comentarios van aquí, fuera
    del script, para que no lleguen al HTML publicado.
    Con JS la sección es siempre interactiva (.pb-int: un problema cada vez, como antes) y además se fija (.pb-fijo, con un nivel de
    compactación .pb-nv0…3) si cabe. «Cabe» se decide con la altura de la ventana PEQUEÑA (una sonda de 100svh), con la fuente raíz y con el
    ancho útil (sin barra de desplazamiento) dividido por esa fuente, nunca con la altura que sigue a la barra del navegador: así plegar o
    desplegar la barra no cambia de modo a mitad de scroll. Tabla UM: svh mínimo, a 16 px de fuente, para cada nivel (del más holgado al más
    compacto), por banda de ancho (desde ese ancho en rem × 16), medido con las réplicas a 12 px en móvil: lo que necesita el contenido de la
    escena más la cabecera (68 px) y 2-3 px de holgura. Escritorio: nv0 es el tamaño de siempre y nv1 compacta. Móvil (desde 360 px): nv0 de
    siempre, nv1 quita aire, nv2 además oculta el párrafo y nv3 además la nota de la réplica. Sin svh, con «reducir movimiento» o por debajo de
    todo: sin pin. Si problemas.js no arranca en 4 s (falla o la petición se cuelga), pbRetira apila los cuatro problemas completos y deja al
    usuario en el que veía o, si estaba debajo, con lo mismo en pantalla. El ancla #p-… / #w-… de la URL se guarda en pbHash y se quita
    de la URL mientras carga, para que el salto nativo al fragmento no pise el de problemas.js; problemas.js la devuelve a la URL. */}
<script is:inline>
(function () {
  var s = document.querySelector('[data-pb]');
  if (!s) return;
  var pista = s.querySelector('[data-pb-pista]'), esc = s.querySelector('[data-pb-escena]'), pares = s.querySelectorAll('[data-par]'), pvs = s.querySelectorAll('[data-pv]');
  var RM = matchMedia('(prefers-reduced-motion: reduce)'), ANCHO = matchMedia('(min-width: 768px)');
  var NIV = ['pb-nv0', 'pb-nv1', 'pb-nv2', 'pb-nv3'], sonda = null, clave = '', i;
  var UM = { d: [[1280, [705, 541]], [1024, [770, 551]], [768, [908, 648]]], m: [[430, [862, 729, 668, 602]], [390, [862, 754, 687, 621]], [360, [888, 774, 687, 621]]] };
  var svhPx = function () {
    if (!window.CSS || !CSS.supports || !CSS.supports('height', '100svh')) return 0;
    if (!sonda) {
      sonda = document.createElement('div');
      sonda.setAttribute('aria-hidden', 'true');
      sonda.style.cssText = 'position:absolute;left:0;top:0;width:0;height:100svh;visibility:hidden;pointer-events:none';
      s.appendChild(sonda);
      s.pbSonda = sonda;
    }
    return sonda.offsetHeight;
  };
  var cab = document.querySelector('.cab');
  var arriba = function () { return s.classList.contains('pb-fijo') ? (parseFloat(getComputedStyle(esc).top) || 0) : (cab ? cab.getBoundingClientRect().bottom : 0); };
  s.pbArriba = arriba;
  s.pbAncla = function () {
