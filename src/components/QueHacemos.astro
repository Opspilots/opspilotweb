---
// «Qué hacemos» (portada, bajo la cabecera), 16-nov-2026: las dos promesas de «Document 1» (captar clientes y mejorar los
// procesos) dichas como las diría el dueño, cada una con las soluciones concretas que la cumplen y su página. Las
// herramientas gratis van en una línea debajo, no como tercera entrada. Sin precios. Los titulares no empiezan por «Que»:
// la cola de la Q de Bricolage, a ese tamaño, parece un subrayado bajo «ue».
// Forma (17-nov-2026): en claro, cada promesa con su móvil (mapa y panel de pedidos) y sus soluciones como filas de enlace.
// Antes, sobre navy con tarjetas oscuras: a Pelayo le sonaba a la web antigua.
import { WA } from '../lib/sitio';
import { version } from '../lib/version';
import Movil from './Movil.astro';
// el móvil y sus pantallas viven en cabecera-pagina.css (la portada no lleva esa cabecera: se carga aquí)
const CSS_TEL = `/css/cabecera-pagina.css?v=${version('/css/cabecera-pagina.css')}`;

const PROMESAS = [
  {
    id: 'clientes',
    movil: 'maps' as const,
    titulo: 'Más clientes que te encuentran y te llaman',
    texto: 'Cuando alguien busca lo que haces en Córdoba, que salgas tú en el mapa y que tu web le explique de un vistazo qué haces, dónde y cómo pedirte presupuesto.',
    enlaces: [
      { href: '/posicionamiento-google-maps-cordoba/', icono: 'map-pin', t: 'Salir en Google Maps', d: 'Tu ficha completa, con reseñas y fotos de tus trabajos' },
      { href: '/webs/', icono: 'globe', t: 'Una página web que traiga clientes', d: 'Una página por cada cosa que haces y por zona' },
    ],
  },
  {
    id: 'papeles',
    movil: 'panel' as const,
    titulo: 'Menos tiempo perdido en papeles',
    texto: 'Presupuestos, pedidos, stock y facturas en un solo sitio y hechos a tu manera, para no copiar el mismo dato en tres programas ni buscarlo en el WhatsApp.',
    enlaces: [
      { href: '/soluciones/#presupuestos', icono: 'file-text', t: 'Presupuestos y facturas', d: 'El presupuesto aceptado se convierte en factura sin teclear nada' },
      { href: '/soluciones/#pedidos', icono: 'package', t: 'Pedidos y stock', d: 'Cada pedido en una ficha, con lo que queda en el almacén' },
    ],
  },
];
---
<link rel="stylesheet" href={CSS_TEL}>
<section class="s-papel que" id="que-hacemos" aria-labelledby="t-que">
  <div class="wrap">
    <h2 id="t-que" class="h2" data-entra>Te ayudamos con dos cosas</h2>
    <p class="lead" data-entra style="--entra-d:8%">Somos un equipo pequeño de Córdoba. No te vendemos una web ni un programa: te ayudamos a conseguir clientes y a que el trabajo de cada día te lleve menos tiempo.</p>
    <div class="promesas">
      {PROMESAS.map((p) => (
        <div class="promesa" id={`promesa-${p.id}`} data-entra style={`--entra-d:${p.id === 'clientes' ? 14 : 22}%`}>
          <div class="promesa-tel"><Movil clave={p.movil} /></div>
          <div class="promesa-texto">
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          <ul class="promesa-sol">
            {p.enlaces.map((e) => (
              <li><a href={e.href}><svg class="ico" aria-hidden="true"><use href={`#i-${e.icono}`}/></svg><span><b>{e.t}</b><small>{e.d}</small></span><svg class="ico ir" aria-hidden="true"><use href="#i-chevron-right"/></svg></a></li>
            ))}
          </ul>
          </div>
        </div>
      ))}
    </div>
    <p class="que-gratis"><svg class="ico" aria-hidden="true"><use href="#i-calculator"/></svg><span>¿Prefieres mirarlo tú primero? Tienes <a href="/herramientas/">herramientas gratis</a> para ver <a href="/herramientas/negocio-no-sale-en-google-maps/">por qué no sales en Google Maps</a>, <a href="/herramientas/pedir-resenas-google/">pedir reseñas</a> o <a href="/herramientas/calcular-iva-irpf-factura/">calcular el IVA de una factura</a>.</span></p>
    <div class="porque-pie">
      <a class="btn btn-verde" href={WA('Hola OpsPilot, os escribo desde la web. Os cuento mi caso:')} rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-message-circle"/></svg>Cuéntanos tu caso</a>
      <p>Respuesta en menos de 24 h. También en <a class="enlace enlace-claro" href="/contacto/">contacto</a>.</p>
    </div>
  </div>
</section>
