---
// Pantalla de producto (réplica fiel, datos reales). La activa public/js/opspilot.js por su data-atributo.
---
<div class="ventana t-ed" data-ed>
              <div class="ed-app">
                <nav class="ed-lado" aria-label="EnergyDeal">
                  <p class="ed-logo">EnergyDeal</p>
                  <p class="on"><svg class="ico" aria-hidden="true"><use href="#i-calculator"/></svg>Comparador</p>
                  <p><svg class="ico" aria-hidden="true"><use href="#i-users"/></svg>Clientes</p>
                  <p><svg class="ico" aria-hidden="true"><use href="#i-receipt"/></svg>Comisiones</p>
                  <p><svg class="ico" aria-hidden="true"><use href="#i-file-text"/></svg>Tarifas</p>
                </nav>
                <div class="ed-main">
                  <p class="ed-top"><span class="ed-busca"><svg class="ico" aria-hidden="true"><use href="#i-search"/></svg>Buscar CIF o CUPS</span><span class="chip chip-demo">Demo · datos de ejemplo</span></p>
                  <p class="ed-cli"><b>CIF B•••••••</b><span>2 CUPS · ES00•• •••• ••••</span><span>10 kW · 10.000 kWh/año</span></p>
                  <table class="ed-tabla" data-ed-tabla>
                    <thead><tr><th>Oferta</th><th>Potencia <small>€/kW·día</small></th><th>Energía <small>€/kWh</small></th><th>Permanencia</th><th>Coste anual</th></tr></thead>
                    <tbody><tr><td>Oferta A</td><td>0,0891</td><td>0,1342</td><td>12 meses</td><td><b>1.667,22 €</b></td></tr><tr><td>Oferta B</td><td>0,0763</td><td>0,1419</td><td>Sin permanencia</td><td><b>1.697,50 €</b></td></tr><tr class="mejor"><td>Oferta C</td><td>0,1027</td><td>0,1275</td><td>24 meses</td><td><b>1.649,86 €</b></td></tr></tbody>
                  </table>
                  <div class="ed-acc">
                    <button type="button" class="ed-btn" data-guardar><svg class="ico" aria-hidden="true"><use href="#i-lock"/></svg>Guardar comparativa</button>
                    <button type="button" class="ed-btn ed-btn-sec" data-mover><svg class="ico" aria-hidden="true"><use href="#i-refresh-cw"/></svg>Llegan tarifas nuevas</button>
                  </div>
                  <div class="ed-com">
                    <p class="ed-sub">Comisión de este cliente</p>
                    <p class="ed-estados"><span class="on" data-estado>pendiente</span><svg class="ico" aria-hidden="true"><use href="#i-chevron-right"/></svg><span data-estado>validada</span><svg class="ico" aria-hidden="true"><use href="#i-chevron-right"/></svg><span data-estado>pagada</span><span class="rev" data-estado>revertida</span></p>
                    <button type="button" class="ed-btn ed-btn-sec ed-btn-min" data-avanzar>Avanzar estado</button>
                    <ol class="ed-log" data-log aria-live="polite"><li><b>alta</b> comisión creada · pendiente</li></ol>
                  </div>
                </div>
                <aside class="ed-snap" data-snap hidden>
                  <p class="ed-snap-t"><svg class="ico" aria-hidden="true"><use href="#i-snowflake"/></svg>Snapshot inmutable</p>
                  <p class="ed-snap-h">guardada <b data-snap-hora></b></p>
                  <p class="ed-snap-h">huella <code data-snap-hash></code></p>
                  <ul class="ed-snap-l" data-snap-l></ul>
                  <p class="ed-snap-d" data-snap-d></p>
                </aside>
