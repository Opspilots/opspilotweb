---
// Cabecera de la home, «La mesa» (4-nov-2026): una mesa de trabajo vista desde arriba que pasa del lío (papeles,
// avisos sin atender) a todo en una sola pantalla. De arriba abajo: el titular sobre una tabla de madera, el dibujo
// (generado en la construcción: src/lib/mesa.ts) y, debajo, el tablón que cierra la mesa con lo que ofrecemos y el contacto.
// El dibujo es decorativo (aria-hidden) y se recoge solo, una vez, cuando se ve (public/js/lamesa.js): no hay mando.
// Sin JS o con «reducir movimiento», la mesa llega ya recogida y quieta.
import { WA, PHONE } from '../lib/sitio';
import { mesa } from '../lib/mesa';
import { version } from '../lib/version';

// nginx sirve .css y .js con «Cache-Control: public, immutable»: la versión va en la URL (ver DEPLOY.md).
const CSS = `/css/lamesa.css?v=${version('/css/lamesa.css')}`;
const JS = `/js/lamesa.js?v=${version('/js/lamesa.js')}`;
const m = mesa();
---
<link rel="stylesheet" href={CSS}>
<section class="lm" data-lm aria-labelledby="titular">
  <div class="lm-tira">
    <svg class="lm-veta" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true" focusable="false" set:html={m.veta} />
    <div class="wrap">
      <h1 id="titular" class="lm-h1"><span class="lm-sobre">Digitalización y webs en Córdoba<span class="sr">:</span></span> <span class="lm-grande">Todo tu negocio, en un solo sitio.</span></h1>
    </div>
  </div>

  <div class="lm-escena" data-escena>
    <svg class="lm-madera" aria-hidden="true" focusable="false" set:html={m.madera} />
    <div class="lm-vista">
      <svg class="lm-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs set:html={m.defs} /></svg>
      <svg class="lm-svg lm-ancho" viewBox="0 178 1440 654" aria-hidden="true" focusable="false" set:html={m.ancho} />
      <svg class="lm-svg lm-alto" viewBox="0 16 360 544" aria-hidden="true" focusable="false" set:html={m.alto} />
    </div>
    <p class="sr">Ilustración decorativa: una mesa con papeles, avisos y facturas sueltas que se ordena hasta quedar una sola pantalla con tu web, tu ficha de Google, los pedidos y los avisos automáticos.</p>
  </div>

  <div class="lm-pie">
    <svg class="lm-veta" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true" focusable="false" set:html={m.veta} />
    <div class="wrap lm-pie-in">
      <div class="lm-apoyo">
        <p class="lm-servicios">Webs y ficha de Google, soluciones a medida y herramientas gratis.</p>
        {/* PROMESA: se mantiene (decisión del dueño, 11-nov-2026). Para quitarla, borrar este <ul> (y «.lm-promesa» en public/css/lamesa.css).
            OJO: la meta description de src/pages/index.astro también repite «desde 500 €» y «respuesta en menos de 24 h». */}
        <ul class="lm-promesa">
          <li><svg class="ico" aria-hidden="true"><use href="#i-shield-check"/></svg>Desde 500&nbsp;€</li>
          <li><svg class="ico" aria-hidden="true"><use href="#i-clock"/></svg>Respuesta en menos de 24 h</li>
        </ul>
      </div>
      <div class="lm-contacto">
        <div class="lm-acciones">
          <a class="btn btn-tinta" href={WA('Hola OpsPilot, os escribo desde la web. Os cuento mi caso:')} rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-message-circle"/></svg>Cuéntanos tu caso</a>
          <a class="btn btn-linea btn-tel" href={`tel:${PHONE.e164}`} aria-label={`Llamar al ${PHONE.display}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><span class="tel-num">{PHONE.display}</span></a>
        </div>
      </div>
    </div>
  </div>
</section>
{/* si el script no carga, la mesa se queda recogida (.sin-script); onerror inline: la CSP ya admite 'unsafe-inline' en script-src */}
<script is:inline src={JS} defer onerror="document.querySelector('[data-lm]').classList.add('sin-script')"></script>
