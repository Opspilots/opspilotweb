---
// Cabecera de la home, «La mesa» (4-nov-2026): una mesa de trabajo vista desde arriba que pasa del lío (papeles,
// avisos sin atender) a todo en una sola pantalla. Texto y contacto arriba, sobre la tabla de madera; debajo, el
// dibujo (generado en la construcción: src/lib/mesa.ts) y el mando para recogerla (public/js/lamesa.js).
// El dibujo es decorativo (aria-hidden); el mando es un <input type="range"> con etiqueta.
// Sin JS o con «reducir movimiento», la mesa llega ya recogida y quieta.
import { WA, PHONE } from '../lib/sitio';
import { mesa } from '../lib/mesa';
import { version } from '../lib/version';

// nginx sirve .css y .js con «Cache-Control: public, immutable»: la versión va en la URL (ver DEPLOY.md).
const CSS = `/css/lamesa.css?v=${version('/css/lamesa.css')}`;
const JS = `/js/lamesa.js?v=${version('/js/lamesa.js')}`;
const m = mesa();
---
<link rel="stylesheet" href={CSS}>
<section class="lm" data-lm aria-labelledby="titular">
  <div class="lm-tira">
    <svg class="lm-veta" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true" focusable="false" set:html={m.veta} />
    <div class="wrap">
      <h1 id="titular" class="lm-h1"><span class="lm-sobre">Agencia de digitalización en Córdoba<span class="sr">:</span></span> <span class="lm-grande">Todo tu negocio, en un solo sitio.</span></h1>
      <div class="lm-fila">
        <div class="lm-apoyo">
          <p class="lm-servicios">Webs, ficha de Google, herramientas a medida y automatización.</p>
          {/* PROMESA: el dueño aún no ha decidido si se queda. Para quitarla, borrar este <ul> (y «.lm-promesa» en public/css/lamesa.css).
              OJO: la meta description de src/pages/index.astro también repite «precio cerrado desde 500 €» y «respuesta en menos de 24 h». */}
          <ul class="lm-promesa">
            <li><svg class="ico" aria-hidden="true"><use href="#i-shield-check"/></svg>Desde 500 €</li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-clock"/></svg>Respuesta en menos de 24 h</li>
          </ul>
        </div>
        <div class="lm-contacto">
          <div class="lm-acciones">
            <a class="btn btn-tinta" href={WA('Hola OpsPilot, os escribo desde la web. Os cuento mi caso:')} rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-message-circle"/></svg>Cuéntanos tu caso</a>
            <a class="btn btn-linea btn-tel" href={`tel:${PHONE.e164}`} aria-label={`Llamar al ${PHONE.display}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><span class="tel-num">{PHONE.display}</span></a>
          </div>
          <p class="lm-casos"><a class="enlace" href="#casos">Ver lo que hemos hecho <svg class="ico" aria-hidden="true"><use href="#i-chevron-down"/></svg></a></p>
        </div>
      </div>
    </div>
  </div>

  <div class="lm-escena" data-escena>
    <svg class="lm-madera" aria-hidden="true" focusable="false" set:html={m.madera} />
    <div class="lm-vista">
      <svg class="lm-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs set:html={m.defs} /></svg>
      <svg class="lm-svg lm-ancho" viewBox="0 178 1440 654" aria-hidden="true" focusable="false" set:html={m.ancho} />
      <svg class="lm-svg lm-alto" viewBox="0 0 360 560" aria-hidden="true" focusable="false" set:html={m.alto} />
    </div>
    <div class="lm-mando">
      <label class="sr" for="lm-rango">Mesa de trabajo: de revuelta a recogida</label>
      <span class="lm-mando-et" aria-hidden="true">Hoy</span>
      <input id="lm-rango" type="range" min="0" max="100" step="1" value="100" aria-describedby="lm-desc">
      <span class="lm-mando-et" aria-hidden="true">Recogida</span>
    </div>
    <p id="lm-desc" class="sr">Ilustración decorativa: una mesa con papeles, avisos y facturas sueltas que se recoge hasta quedar una sola pantalla con tu web, tu ficha de Google, los pedidos y los avisos automáticos.</p>
  </div>
</section>
{/* si el script no carga, la mesa se queda recogida (.sin-script); onerror inline: la CSP ya admite 'unsafe-inline' en script-src */}
<script is:inline src={JS} defer onerror="document.querySelector('[data-lm]').classList.add('sin-script')"></script>
