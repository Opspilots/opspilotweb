---
// Cabecera única de las páginas interiores (v5, 27-sep, revisión de Pelayo): la misma escala y los mismos
// márgenes en todas, el horizonte siempre y todo dentro de la primera pantalla. Sin migas visibles:
// la ruta la sigue leyendo Google en el BreadcrumbList del JSON-LD de cada página.
interface Props {
  sobre: string;
  titulo: string;
  entrada?: string;
}
const { sobre, titulo, entrada } = Astro.props;
---
<section class="portada portada-sub" aria-labelledby="titular">
  <div class="wrap portada-in">
    <div class="portada-texto">
      <h1 id="titular">
        <span class="sobre">{sobre}</span>
        <span class="grande grande-sub">{titulo}</span>
      </h1>
      {entrada && <p class="entrada">{entrada}</p>}
      <slot />
    </div>
    <div class="instrumento instrumento-sub" aria-hidden="true">
      <div class="actitud">
        <div class="giro"><div class="suelo"></div></div>
        <svg class="aro" viewBox="0 0 100 100"><use href="#aro"/></svg>
      </div>
    </div>
  </div>
</section>
