---
// Cabecera de las páginas interiores (16-nov-2026): «el aro con la solución dentro». Fondo navy de la marca a sangre, el
// texto a la izquierda y, a la derecha (debajo en el móvil), el aro del logo en grande con un móvil dentro que enseña la
// solución de esa página funcionando. Qué móvil lleva cada ruta: OBJETO_POR_RUTA en src/lib/objetos-pagina.ts (el prop
// `objeto` la salta). Las pantallas son ejemplos (negocio neutro), salvo las webs, que son capturas reales de su web
// pública: Córdoba Soluciona (/webs/), J.R. Rodríguez y PresupuesYa, nuestro programa de presupuestos (/soluciones/).
// Movimiento (solo CSS, transform y opacity, una vez y sin bucles salvo el desplazamiento lento de la web): el aro se
// nivela como el horizonte de un instrumento y la pantalla hace su gesto. Con «reducir movimiento», todo quieto y en su
// estado final. Estilos: public/css/cabecera-pagina.css (con ?v=). El H1 sigue siendo .grande-sub (opspilot.css).
import { objetoDeRuta, type ClaveObjeto } from '../lib/objetos-pagina';
import { version } from '../lib/version';
import Movil from './Movil.astro';

interface Props {
  /** ya no se pinta (v12, revisión de Pelayo): el H1 lleva la palabra clave. Se mantiene por compatibilidad */
  sobre?: string;
  titulo: string;
  entrada?: string;
  /** salta la tabla por ruta */
  objeto?: ClaveObjeto;
}
const { titulo, entrada } = Astro.props;
const clave = Astro.props.objeto ?? objetoDeRuta(Astro.url.pathname);
const conAro = clave !== 'ninguno';
const conMovil = conAro && clave !== 'aro';
// nginx sirve .css con «Cache-Control: public, immutable»: la versión va en la URL (ver DEPLOY.md).
const CSS = `/css/cabecera-pagina.css?v=${version('/css/cabecera-pagina.css')}`;
---
<link rel="stylesheet" href={CSS}>
<section class:list={['cp', conAro ? 'cp-con' : 'cp-sin', `cp-${clave}`]} data-objeto={clave} aria-labelledby="titular">
  <div class="wrap cp-in">
    <div class="cp-texto">
      <h1 id="titular" class="grande grande-sub cp-h1">{titulo}</h1>
      {entrada && <p class="entrada">{entrada}</p>}
      {/* los botones y enlaces: en el móvil van debajo del aro con el teléfono (17-nov-2026, Pelayo); ver cabecera-pagina.css */}
      <div class="cp-acc"><slot /></div>
    </div>
    {conAro && (
      <div class="cp-firma">
        <svg class="cp-anillo" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#aro"/></svg>
        {conMovil && (
          <Movil clave={clave} />
        )}
      </div>
    )}
  </div>
</section>
