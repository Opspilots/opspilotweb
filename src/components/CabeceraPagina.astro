---
// Cabecera de página interior: la firma (el horizonte del aro) en pequeño a la derecha,
// cielo verde y suelo navy. Nada dentro del aro.
import Migas from './Migas.astro';
interface Props {
  sobre: string;
  titulo: string;
  entrada?: string;
  migas: { nombre: string; path: string }[];
  horizonte?: boolean;
}
const { sobre, titulo, entrada, migas, horizonte = true } = Astro.props;
---
<section class="portada portada-sub" aria-labelledby="titular">
  <div class="wrap portada-in">
    <div class="portada-texto">
      <Migas items={migas} />
      <h1 id="titular">
        <span class="sobre">{sobre}</span>
        <span class="grande grande-sub">{titulo}</span>
      </h1>
      {entrada && <p class="entrada">{entrada}</p>}
      <slot />
    </div>
    {horizonte && (
      <div class="instrumento instrumento-sub" aria-hidden="true">
        <div class="actitud">
          <div class="giro"><div class="suelo"></div></div>
          <svg class="aro" viewBox="0 0 100 100"><use href="#aro"/></svg>
        </div>
      </div>
    )}
  </div>
</section>
