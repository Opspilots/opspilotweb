---
// «Por qué con nosotros»: lo que suele pasar con una agencia frente a cómo lo hacemos, fila a fila.
// Solo compromisos que ya cumplimos (vigilancia cada minuto, precio cerrado, casos reales arriba).
import { WA } from '../lib/sitio';
const filas = [
  { corto: 'Precio cerrado y por escrito, desde 500 €.', tema: 'El precio', suele: '«Depende», y la cifra llega después de varias llamadas.', nos: 'Precio cerrado y por escrito antes de empezar. Una web, desde 500 €.' },
  { corto: 'Negocios reales, con datos medidos.', tema: 'Lo que enseñan', suele: 'Logos sueltos o ejemplos de negocios inventados.', nos: 'Negocios de aquí, con su nombre, su web en marcha y datos medidos. Los tienes justo arriba.' },
  { corto: 'Web, ficha de Google y herramientas.', tema: 'Lo que hacen', suele: 'La web y poco más.', nos: 'Web, ficha de Google y herramientas a medida: tiendas, paneles de pedidos, presupuestos.' },
  { corto: 'Nos quedamos: vigilamos tu web cada minuto.', tema: 'Después', suele: 'Te la entregan y no vuelves a saber de ellos.', nos: 'Nos quedamos: vigilamos tu web cada minuto y te contamos cómo va.' },
  { corto: 'Sin palabras raras.', tema: 'Cómo hablan', suele: 'Jerga y paquetes cerrados.', nos: 'Sin palabras raras. Y si algo no lo necesitas, te lo decimos.' },
  { corto: 'En Córdoba.', tema: 'Dónde están', suele: 'Lejos, al otro lado del teléfono.', nos: 'En Córdoba.' },
];
---
<section class="porque s-hondo" id="por-que" aria-labelledby="t-porque">
  <div class="wrap">
    <div class="porque-cab">
      <p class="etiqueta">Por qué con nosotros</p>
      <h2 id="t-porque" class="h2">Lo que suele pasar con una agencia, y cómo lo hacemos nosotros.</h2>
    </div>
    <div class="porque-tabla" role="table" aria-label="Comparación">
      <div class="pq-fila pq-cab" role="row"><span role="columnheader"></span><span role="columnheader">Lo que suele pasar</span><span role="columnheader"><svg class="v-aro" viewBox="0 0 100 100" aria-hidden="true"><use href="#aro"/></svg>Con OpsPilot</span></div>
      {filas.map((f) => (
        <div class="pq-fila" role="row">
          <span class="pq-tema" role="rowheader">{f.tema}</span>
          <span class="pq-suele" role="cell">{f.suele}</span>
          <span class="pq-nos" role="cell">{f.nos}</span>
        </div>
      ))}
    </div>
    <ul class="pq-movil">
      {filas.map((f) => (<li><svg class="ico" aria-hidden="true"><use href="#i-check"/></svg>{f.corto}</li>))}
    </ul>
    <div class="porque-pie">
      <a class="btn btn-verde" href={WA('Hola OpsPilot, os escribo desde la web. Os cuento mi caso:')} rel="noopener"><svg class="ico" aria-hidden="true"><use href="#i-message-circle"/></svg>Cuéntanos tu caso</a>
      <p>Te contestamos en menos de 24 horas.</p>
    </div>
  </div>
</section>
